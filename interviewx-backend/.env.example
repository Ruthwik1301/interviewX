# -----------------------------------------------------------------------------
# InterviewX backend environment variables
# Copy this file to .env for local development.
# Railway production should set these values in its Variables dashboard.
# -----------------------------------------------------------------------------

# Core app
NODE_ENV=development
PORT=5000
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
MONGODB_URI=mongodb://127.0.0.1:27017/interviewx
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173

# Groq
GROQ_API_KEY=replace-with-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Email / Resend
RESEND_API_KEY=replace-with-resend-api-key
EMAIL_FROM=InterviewX <noreply@your-domain.com>

# Google OAuth
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# JDoodle
JDOODLE_CLIENT_ID=replace-with-jdoodle-client-id
JDOODLE_CLIENT_SECRET=replace-with-jdoodle-client-secret

# Razorpay
RAZORPAY_KEY_ID=replace-with-razorpay-key-id
RAZORPAY_KEY_SECRET=replace-with-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-razorpay-webhook-secret
RAZORPAY_PLAN_ID_PRO=plan_replace_with_pro_plan_id
RAZORPAY_PLAN_ID_TEAM=plan_replace_with_team_plan_id

# Optional: where the app redirects the user after Razorpay checkout closes.
# If omitted, the backend falls back to APP_URL.
PAYMENT_RETURN_URL=http://localhost:5173/app?checkout=success

# Internal QA only: comma-separated list of emails exempt from the daily
# interview-session cap, for your own testing. Leave unset in shared/staging
# environments. This file is just an example - put your real value in your
# local, untracked .env (never commit it).
QA_UNLIMITED_EMAILS=owner_email