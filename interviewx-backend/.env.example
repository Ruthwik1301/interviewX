# -----------------------------------------------------------------------------
# InterviewX backend environment variables
# Copy this file to .env for local development.
# Railway production should set these values in its Variables dashboard.
# -----------------------------------------------------------------------------

# Core app
NODE_ENV=development
PORT=5000
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
MONGODB_URI=mongodb://127.0.0.1:27017/interviewx
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173

# Groq
GROQ_API_KEY=replace-with-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Email / Resend
RESEND_API_KEY=replace-with-resend-api-key
EMAIL_FROM=InterviewX <noreply@your-domain.com>

# Google OAuth
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# JDoodle
JDOODLE_CLIENT_ID=replace-with-jdoodle-client-id
JDOODLE_CLIENT_SECRET=replace-with-jdoodle-client-secret

# Stripe
STRIPE_SECRET_KEY=replace-with-stripe-secret-key
STRIPE_WEBHOOK_SECRET=replace-with-stripe-webhook-secret
STRIPE_PRICE_ID_PRO=price_replace_with_pro_price_id
STRIPE_PRICE_ID_TEAM=price_replace_with_team_price_id

# Optional explicit Stripe redirects.
# If omitted, the backend falls back to APP_URL.
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:5173/app?checkout=success&session_id={CHECKOUT_SESSION_ID}
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:5173/app?checkout=cancelled
