# -----------------------------------------------------------------------------
# InterviewX frontend environment variables
# Copy this file to .env for local development.
# In Vercel, add these values in Project Settings → Environment Variables.
# -----------------------------------------------------------------------------

# Backend API base URL.
# Local development (matches the backend default PORT=5000):
VITE_API_URL=http://localhost:5000

# Production example:
# VITE_API_URL=https://your-backend-production-domain.up.railway.app

# Notes:
# - Never expose backend secrets in the frontend.
# - Stripe, Groq, MongoDB, Resend, JDoodle, JWT, and Google client secrets must
#   stay on the backend only.
# - VITE_API_URL must point at the deployed Railway backend when the frontend is
#   running on Vercel.
